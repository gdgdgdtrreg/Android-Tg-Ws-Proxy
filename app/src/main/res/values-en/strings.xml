<?xml version="1.0" encoding="utf-8"?>
<!--
    English translations. The default language (Russian) lives in `values/`;
    this folder only overrides it for `en*` locales.

    Keep in sync with values/strings.xml: the same names, the same positional
    placeholders (%1$s, %2$d). `python3 tools/check_localization.py` reports any
    missing name, extra name or placeholder mismatch.

    Curly quotes are used on purpose: a straight apostrophe inside a string
    resource must be escaped (\'), and it is easy to forget.
-->
