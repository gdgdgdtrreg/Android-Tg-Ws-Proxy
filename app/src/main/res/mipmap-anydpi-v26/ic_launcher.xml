<?xml version="1.0" encoding="utf-8"?>
<!-- Иконка Android 8+. Два слоя, оба описаны здесь:
       * фон  — цвет из values/ic_launcher_background.xml;
       * передний план — вектор drawable/ic_launcher_foreground.xml.
     Растровых файлов нет ни одного: картинка одна, в XML.
     Иконка для Android 7 и ниже — в mipmap-anydpi/ic_launcher.xml. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
